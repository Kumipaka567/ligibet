# ─── Server Configuration ──────────────────────────────────────
PORT=3000
# Comma-separated browser origins allowed to call the API. An entry may carry
# one wildcard label — "https://*.vercel.app" — which matches a single level of
# subdomain and is how Vercel preview deployments, whose hostname changes with
# every push, reach the API without being listed one by one.
#
# An origin missing from this list fails in the browser only: the request never
# reaches a route, so the site looks like it is hanging rather than reporting an
# error. Add the deployed frontend domains here before wondering why a fresh
# deployment does nothing.
CORS_ORIGIN=http://localhost:4200,https://ligibet.it.com,https://www.ligibet.it.com

# ─── JWT Authentication Secret ─────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ─── MongoDB Database ──────────────────────────────────────────
# The database name before the "?" is REQUIRED and the server refuses to start
# without it. Leaving it out does not fail — the driver quietly picks its own
# default, which is how this deployment once served an empty database while the
# real accounts sat untouched on another cluster.
#
# It must also name the database that actually holds the data. For this
# deployment that is "test", NOT "ligibet" — copying the placeholder below
# verbatim connects you to an empty database that behaves exactly like a
# working one except that every login fails.
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@cluster0.abcde.mongodb.net/<database>?retryWrites=true&w=majority

# For local MongoDB, use this instead:
# MONGODB_URI=mongodb://127.0.0.1:27017/ligibet

# ─── PayHero M-Pesa Integration (Optional) ─────────────────────
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2
PAYHERO_API_USERNAME=your_payhero_api_username
PAYHERO_API_PASSWORD=your_payhero_api_password
PAYHERO_CHANNEL_ID=your_payhero_channel_id
PAYHERO_CALLBACK_URL=https://your-domain.com/api/mpesa/callback

# Bearer token PayHero sends back on the callback above. The callback route
# accepts anything when this is unset, and that route credits wallets, so set it
# on any deployment reachable from the internet.
PAYHERO_CALLBACK_TOKEN=shared_secret_for_the_callback

# Optional: a pre-issued Basic token used instead of the username/password pair.
# PAYHERO_AUTH_TOKEN=

# ─── Database Safety Switch ────────────────────────────────────
# The server refuses to start against a database with zero user accounts,
# because an empty database is indistinguishable from a correct one at the API
# level — logins simply fail and registrations disappear into the void. Set this
# only when a deployment genuinely starts from scratch.
# ALLOW_EMPTY_DATABASE=true
